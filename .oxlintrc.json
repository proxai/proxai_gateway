{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "no-empty-pattern": "warn",
    "no-empty-file": "off",
    "no-unmodified-loop-condition": "off",
    "no-underscore-dangle": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "as", "objectLiteralTypeAssertions": "never" }
    ],
    "typescript/no-unnecessary-type-assertion": "error",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "bun:sqlite",
            "message": "Only services/buffer/, core/io/sqlite/, and source-side sqlite readers may import bun:sqlite directly. Other modules go through services/buffer.",
            "allowTypeImports": true
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/services/polling/poll-loop.ts",
        "src/services/polling/poll-cycle.ts",
        "src/services/polling/poll-claude-code.ts",
        "src/services/polling/poll-codex.ts",
        "src/services/polling/poll-cursor.ts",
        "src/services/polling/poll-gemini-cli.ts",
        "src/services/polling/daemon-loops.ts",
        "src/services/polling/capture-cycle.ts",
        "src/services/polling/poll-worker.ts",
        "src/services/uploader/drain-buffer.ts",
        "src/services/uploader/pacer.ts",
        "src/cli/commands/inspect/index.ts",
        "src/cli/commands/tail/index.ts",
        "src/core/io/fs/rm-recursive.ts",
        "src/core/log/prune.ts",
        "src/core/system/machine-uuid.ts",
        "scripts/build.ts",
        "src/services/uploader/tests/drain-buffer.test.ts",
        "src/services/uploader/tests/pacer.test.ts",
        "src/services/polling/tests/default-sources.test.ts"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["ai/mapper/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["scripts/export-diagrams/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/services/state-machines/**/*.machine.ts"],
      "rules": {
        "typescript/consistent-type-assertions": "off"
      }
    },
    {
      "files": [
        "src/services/buffer/**/*.ts",
        "src/core/io/sqlite/**/*.ts",
        "src/sources/cursor/**/*.ts",
        "src/sources/codex/**/*.ts",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/tests/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "*.md"]
}
