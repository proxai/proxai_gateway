# Build output
dist/
*.tsbuildinfo

# Dependencies
node_modules/

# Bun
.bun/
# `bun build --compile` writes intermediate artifacts at the repo root with
# names like `.18ad1dffff93ff60-00000000.bun-build`. Per-build, machine-
# specific, regenerated every compile — must never be committed.
*.bun-build
.*.bun-build

# Test / coverage
coverage/
.nyc_output/

# Logs
*.log
logs/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local environment
.env
.env.local
.env.*.local

# Local dev state (anything a developer might create when smoke-testing)
.proxai/

# Claude Code project metadata
.claude/
