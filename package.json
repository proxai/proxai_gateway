{
  "name": "@proxai/gateway",
  "version": "0.1.0",
  "description": "ProxAI Gateway — captures coding-agent activity (Claude Code, Cursor, Codex) and ships it to ProxAI's backend with on-device secret redaction.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "proxai-gateway": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "smol-toml": "^1.6.1",
    "uuid": "^14.0.0"
  }
}
