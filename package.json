{
  "name": "@proxai/gateway",
  "version": "2026.5.10",
  "description": "ProxAI Gateway",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "ProxAI",
  "homepage": "https://proxai.co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proxai/proxai_gateway.git"
  },
  "bugs": {
    "url": "https://github.com/proxai/proxai_gateway/issues"
  },
  "keywords": [
    "ai",
    "claude-code",
    "cursor",
    "codex",
    "observability",
    "telemetry",
    "gateway"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "proxai-gateway": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test --parallel",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage --parallel",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "validate": "bun run lint:fix && bun run format && bun run typecheck && bun test && bun run build:darwin-arm64",
    "prepare": "husky || true",
    "build": "bun scripts/build.ts",
    "ai:sync": "bun run ai/mapper/index.ts",
    "build:darwin-arm64": "bun scripts/build.ts darwin-arm64",
    "build:darwin-x64": "bun scripts/build.ts darwin-x64",
    "build:linux-arm64": "bun scripts/build.ts linux-arm64",
    "build:linux-x64": "bun scripts/build.ts linux-x64",
    "build:windows-x64": "bun scripts/build.ts windows-x64",
    "build:windows-arm64": "bun scripts/build.ts windows-arm64",
    "prepare:npm": "bun scripts/publish-npm.ts",
    "release": "bun scripts/release/cli.ts",
    "strip-comments": "bun scratch/strip-comments.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.65.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "smol-toml": "^1.6.1",
    "uuid": "^14.0.0"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
